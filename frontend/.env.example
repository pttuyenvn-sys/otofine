# Local dev (khuyến nghị): để trống 2 biến dưới → trình duyệt gọi /api qua Next (rewrite sang Express).
# Bật backend: cd ../backend && npm start

# NEXT_PUBLIC_API_BASE_URL=http://localhost:5000/api
# NEXT_PUBLIC_API_ORIGIN=http://127.0.0.1:5000

# Tiêu đích rewrite (chỉ server Next đọc; mặc định 127.0.0.1:5000)
# API_INTERNAL_ORIGIN=http://127.0.0.1:5000

# —— SEO bài dài (premium) —— Chỉ server, không bao giờ NEXT_PUBLIC_*
# OpenAI mặc định: OTOFINE_SEO_OPENAI_KEY hoặc OPENAI_API_KEY
# OTOFINE_SEO_PREMIUM_MODEL=gpt-4o-mini
#
# Google Gemini: đặt AI_PROVIDER=gemini + GEMINI_API_KEY
# AI_PROVIDER=gemini
# GEMINI_API_KEY=
# Tùy chọn: OTOFINE_SEO_GEMINI_MODEL=gemini-2.0-flash
#
# part_knowledge + Ollama (chỉ bước Việt hóa/humanize; facts luôn từ DB qua API backend)
# OTOFINE_SEO_KNOWLEDGE_ENGINE=knowledge_only
# OTOFINE_SEO_KNOWLEDGE_ENGINE=knowledge_plus_local_ai
# LOCAL_AI_URL=http://localhost:11434
# LOCAL_AI_MODEL=qwen2.5:7b
#
# Otofine Style Engine — cloud writer + appendix trên mọi bước generateJsonForHumanize (Ollama hoặc cloud)
# OTOFINE_STYLE_ENGINE_MODE=otofine_practical_expert
# v2: persona theo part_knowledge.system_group (BRAKE_SAFETY, AC_COMFORT, …) + hook/CTA/FAQ + luận đoạn đa dạng
# OTOFINE_STYLE_ENGINE_MODE=otofine_practical_expert_v2
# v3: v2 + nhận diện hãng (registry → slug → listing → H1) — intro / lo ngại / cảnh báo / FAQ kết hợp brand × system
# OTOFINE_STYLE_ENGINE_MODE=otofine_practical_expert_v3
# v4: v3 + buyer intent (slug / H1 / category / listing) — viết lại khối + FAQ động; vẫn giữ FACTS
# OTOFINE_STYLE_ENGINE_MODE=otofine_practical_expert_v4
